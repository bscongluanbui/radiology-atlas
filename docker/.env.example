# Tên miền thường hoặc DDNS trỏ tới VPS; không ghi https:// và không thêm /.
DDNS_HOST=atlas.example.com
# Giữ nguyên thư mục all_modules; container chỉ mount read-only.
DATA_ROOT=/srv/radiology/imaios_data/all_modules
VIEWER_IMAGE=radiology-atlas-viewer:local
BUILD_REVISION=local
METADATA_CACHE_MIB=128
BROWSER_CACHE_MIB=256
CACHE_TTL_SECONDS=900
SESSION_IDLE_SECONDS=1800
SESSION_LIFETIME_SECONDS=28800
